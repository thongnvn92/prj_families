# Cấu hình frontend (Vite). Copy file này thành .env rồi chỉnh nếu chạy port khác.
# Các giá trị mặc định bên dưới PHẢI khớp laravel_api/.env và laravel_api/.env.example.

# Base URL của Laravel API (dùng cho RTK Query và endpoint /broadcasting/auth).
VITE_API_URL=http://127.0.0.1:8080/api/v1

# Reverb: app key phải khớp REVERB_APP_KEY trong laravel_api/.env.
VITE_REVERB_APP_KEY=gia-pha-dev-key
VITE_REVERB_HOST=127.0.0.1
# Cổng WebSocket của Reverb (REVERB_PORT). Lưu ý: 8080 là cổng HTTP của Laravel API,
# Reverb local chạy ở 8081 theo run-local.ps1.
VITE_REVERB_PORT=8081
# http => ws://, https => wss:// (khớp REVERB_SCHEME).
VITE_REVERB_SCHEME=http
